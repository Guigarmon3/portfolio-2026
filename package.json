{
  "name": "guillermo-garcia-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"npm:dev\"",
    "server": "node server/index.mjs",
    "auth:setup": "node scripts/setup-credentials.mjs",
    "ntfy:info": "node scripts/ntfy-info.mjs",
    "ntfy:test": "node scripts/ntfy-test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "db:migrate": "wrangler d1 execute portfolio-2026-db --remote --file=worker/schema.sql",
    "deploy": "npm run build && wrangler deploy",
    "deploy:www": "wrangler deploy --config wrangler.www.jsonc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "concurrently": "^10.0.7",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
