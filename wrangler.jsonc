{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-2026",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-2026-db",
      "database_id": "9d21f3d1-4a9d-4323-ace8-64781a7781d0"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "UPLOADS",
      "id": "d7abcc53e3c0467a9bc165b6d9353506"
    }
  ],
  "vars": {
    "SITE_URL": "https://guigarmon3.online",
    "NTFY_SERVER": "https://ntfy.sh"
  },
  "routes": [
    {
      "pattern": "guigarmon3.online/*",
      "zone_name": "guigarmon3.online"
    }
  ],
  "observability": {
    "enabled": true
  }
}
